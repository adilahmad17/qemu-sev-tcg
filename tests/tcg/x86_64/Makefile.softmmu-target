#
# x86_64 system tests
#

X64_SYSTEM_SRC=$(SRC_PATH)/tests/tcg/x86_64/system
X64_SYSTEM_TESTS=$(patsubst $(X64_SYSTEM_SRC)/%.c, %, $(wildcard $(X64_SYSTEM_SRC)/*.c))

VPATH+=$(X64_SYSTEM_SRC)

# These objects provide the basic boot code and helper functions for all tests
CRT_OBJS=boot.o

CRT_PATH=$(X64_SYSTEM_SRC)
LINK_SCRIPT=$(X64_SYSTEM_SRC)/kernel.ld
LDFLAGS=-Wl,-T$(LINK_SCRIPT) -Wl,-melf_x86_64
CFLAGS+=-nostdlib -ggdb -O0 $(MINILIB_INC)
LDFLAGS+=-static -nostdlib $(CRT_OBJS) $(MINILIB_OBJS) -lgcc

TESTS+=$(MULTIARCH_TESTS) $(X64_SYSTEM_TESTS)
EXTRA_RUNS+=$(MULTIARCH_RUNS)

# building head blobs
.PRECIOUS: $(CRT_OBJS)

%.o: $(CRT_PATH)/%.S
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) -Wa,--noexecstack -c $< -o $@

# Build and link the tests
%: %.c $(LINK_SCRIPT) $(CRT_OBJS) $(MINILIB_OBJS)
	$(CC) $(CFLAGS) $(EXTRA_CFLAGS) $< -o $@ $(LDFLAGS)

memory: CFLAGS+=-DCHECK_UNALIGNED=1

# Running
QEMU_OPTS+=-device isa-debugcon,chardev=output -device isa-debug-exit,iobase=0xf4,iosize=0x4 -kernel

# The emulated SEV-ES guest tests boot from an IGVM file (mkigvm.py wraps
# the test ELF) as an sev-emu guest with the SEV-ES policy; they need a
# QEMU built with IGVM support. The test binary that the generic rule appends
# becomes the VM name.
SEV_ES_TESTS=sev-es sev-es-term
SEV_ES_QEMU_OPTS=-M q35,confidential-guest-support=sev0,igvm-cfg=igvm0 \
	-object sev-emu,id=sev0,cbitpos=51,reduced-phys-bits=1,policy=0x5 \
	-cpu max -smp 2 \
	-device isa-debugcon,chardev=output -device isa-debug-exit,iobase=0xf4,iosize=0x4

SEV_SNP_TESTS=sev-snp
SEV_SNP_QEMU_OPTS=-M q35,confidential-guest-support=sev0,igvm-cfg=igvm0 \
	-object sev-snp-emu,id=sev0,cbitpos=51,reduced-phys-bits=1,policy=0x30000 \
	-cpu max -smp 2 \
	-device isa-debugcon,chardev=output -device isa-debug-exit,iobase=0xf4,iosize=0x4

$(SEV_ES_TESTS) $(SEV_SNP_TESTS): CFLAGS+=-mno-red-zone

sev-snp.igvm: sev-snp $(X64_SYSTEM_SRC)/mkigvm.py
	$(PYTHON) $(X64_SYSTEM_SRC)/mkigvm.py --platform snp $< $@

%.igvm: % $(X64_SYSTEM_SRC)/mkigvm.py
	$(PYTHON) $(X64_SYSTEM_SRC)/mkigvm.py --platform sev-es $< $@

run-sev-snp: run-%: %.igvm
run-sev-snp: QEMU_OPTS=$(SEV_SNP_QEMU_OPTS) -object igvm-cfg,id=igvm0,file=$<.igvm -name
run-plugin-sev-snp-with-%: QEMU_OPTS=$(SEV_SNP_QEMU_OPTS) -object igvm-cfg,id=igvm0,file=$(call strip-plugin,$<).igvm -name

$(foreach t,$(SEV_ES_TESTS),run-$(t)): run-%: %.igvm
$(foreach t,$(SEV_ES_TESTS),run-$(t)): QEMU_OPTS=$(SEV_ES_QEMU_OPTS) -object igvm-cfg,id=igvm0,file=$<.igvm -name
$(foreach t,$(SEV_ES_TESTS),run-plugin-$(t)-with-%): QEMU_OPTS=$(SEV_ES_QEMU_OPTS) -object igvm-cfg,id=igvm0,file=$(call strip-plugin,$<).igvm -name

ifeq ($(CONFIG_PLUGIN),y)
run-plugin-patch-target-with-libpatch.so:		\
	PLUGIN_ARGS=$(COMMA)target=ffc0$(COMMA)patch=9090$(COMMA)use_hwaddr=true
run-plugin-patch-target-with-libpatch.so:		\
	CHECK_PLUGIN_OUTPUT_COMMAND=$(X64_SYSTEM_SRC)/validate-patch.py $@.out
run-plugin-patch-target-with-libpatch.so: patch-target libpatch.so
EXTRA_RUNS_WITH_PLUGIN+=run-plugin-patch-target-with-libpatch.so
endif
